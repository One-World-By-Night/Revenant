# The bot's Discord token, from the Discord developer portal.
DISCORD_TOKEN=

# The Discord application id, used to register commands.
DISCORD_APPLICATION_ID=

# Postgres connection string, e.g. postgres://user:password@db:5432/berevenant
DATABASE_URL=

# 32 bytes, base64-encoded. Encrypts each connected server's shared secret at rest.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRET_KEY=

# Optional. The name the bot uses for itself in messages. Default: Revenant
BOT_DISPLAY_NAME=

# Optional. en-US or pt-BR, for public posts when a server sets no language. Default: en-US
DEFAULT_LOCALE=

# Optional. debug, info, warn or error. Default: info
LOG_LEVEL=

# Optional. Port for the /healthz endpoint, bound to localhost. Default: 8080
HEALTH_PORT=

# Optional. When set, commands register to this one server only, so changes show at once.
DEV_GUILD_ID=

# Optional. Allows http://localhost sites for development only. Default: off
ALLOW_INSECURE_LOCALHOST=

# Optional. Read from step 5; unused in step 1.
EVENT_POLL_SECONDS=
